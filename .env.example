# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=melotech
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/melotech

# Redis
REDIS_URL=redis://localhost:6379

# App environment (development | test | production)
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Better Auth (web only)
BETTER_AUTH_SECRET=change_me_in_production
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Provider (used by worker for text generation)
AI_PROVIDER=ollama
AI_MODEL=llama3
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=your_ollama_api_key

# Embedding Provider (used by worker for semantic cache)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your_openai_api_key

# Retry and similarity settings
GENERATION_RETRY_LIMIT=3
LLM_REPAIR_RETRY_LIMIT=2
SIMILARITY_THRESHOLD=0.85

# Platform credit costs (number of credits per platform generation)
PLATFORM_CREDIT_COST_SPOTIFY=10
PLATFORM_CREDIT_COST_TIKTOK=10
PLATFORM_CREDIT_COST_YOUTUBE=10
