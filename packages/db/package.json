{
  "name": "@melotech/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "prebuild": "pnpm db:generate",
    "build": "tsc",
    "dev": "tsc --watch",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:create": "prisma migrate dev --schema prisma/schema.prisma --create-only",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "pretest": "pnpm db:generate",
    "test": "vitest run",
    "pretypecheck": "pnpm db:generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@melotech/config": "workspace:*",
    "@melotech/shared": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prisma": "^7.8.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
